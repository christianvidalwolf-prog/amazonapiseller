{
  "name": "sp-api-saas-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate --schema src/db/prisma/schema.prisma && tsc -p tsconfig.json",
    "start": "tsx src/server.ts",
    "prisma:generate": "prisma generate --schema src/db/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema src/db/prisma/schema.prisma",
    "worker": "tsx watch src/workers/index.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:scripts",
    "test:unit": "vitest run",
    "test:scripts": "tsx --test \"scripts/lib/*.test.ts\"",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:biome": "biome check src --diagnostic-level=error",
    "knip": "knip",
    "spapi:mcp:assistant": "sp-api-dev-assistant-mcp-server",
    "spapi:mcp:workflow": "sp-api-workflow-mcp",
    "publish:snapshots": "tsx scripts/publish-snapshots.ts",
    "build:costs-index": "tsx scripts/build-costs-index.ts",
    "replicate:fba": "tsx scripts/replicate-fba-offers.ts",
    "enforce:price-bounds": "tsx scripts/enforce-price-bounds.ts",
    "listings:archive": "tsx scripts/archive-stale-listings.ts",
    "listings:delete": "tsx scripts/delete-archived-listings.ts",
    "listings:reactivate": "tsx scripts/reactivate-listings.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "@sentry/node": "^10.75.3",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^4.1.11",
    "knip": "^5.88.1",
    "prisma": "^5.19.1",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
