# Server
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spapi_saas
REDIS_URL=redis://localhost:6379

# LWA / SP-API credentials (same values as the existing root .env)
LWA_CLIENT_ID=
LWA_CLIENT_SECRET=
SP_API_REFRESH_TOKEN=
SP_API_REGION=EU
SP_API_SELLER_ID=
SP_API_MARKETPLACE_IDS=A1RKKUPIHCS9HS

# Amazon Advertising API (PPC) credentials
# If your LWA app has Ads permissions, LWA_CLIENT_ID & SECRET are reused automatically.
ADS_API_CLIENT_ID=
ADS_API_CLIENT_SECRET=
ADS_API_REFRESH_TOKEN=
ADS_API_PROFILE_ID=
ADS_API_REGION=EU

# Brand Analytics → Search Query Performance ("Funnels de Búsqueda"). Needs the Brand Analytics role.
# SQP_ASINS: comma-separated ASINs to analyse. Empty = top sellers in ventas_2026.csv whose title starts with SQP_BRAND.
SQP_ASINS=
SQP_BRAND=ROCKING GIFTS
SQP_MAX_ASINS=36
# Countries the snapshot publisher covers, and how many reports a process may request in a burst
# (it refills at one per minute, like Amazon's own quota).
SQP_MARKETPLACES=ES,DE,FR,IT
SQP_MAX_REPORTS=12
# With SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY set, the report rows are stored in Supabase `snapshots`
# (sqp:metrics:<marketplace>:<WEEK|MONTH>:<period start>) and reused by every sync; otherwise in Postgres.
