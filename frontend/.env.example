# Local: apunta al backend Express. En Vercel NO definir (usa las rutas /api internas).
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Solo en Vercel (Settings → Environment Variables) ---
# APP_PASSWORD=          contraseña de acceso al panel (obligatoria en producción)
# AUTH_SECRET=           cadena aleatoria larga
# SUPABASE_URL=          https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   clave service_role (solo servidor; nunca NEXT_PUBLIC_)

# --- Chatbot público de www.vidalregals.com (specs/chatbot/chatbot.spec.md) ---
# ANTHROPIC_API_KEY=     clave de la API de Claude (solo servidor); pon un límite de gasto en console.anthropic.com
# CHATBOT_MODEL=         opcional, por defecto claude-haiku-5-5
# CHATBOT_ALLOWED_ORIGINS=  opcional, por defecto https://www.vidalregals.com,https://vidalregals.com
# CHATBOT_MAX_MESSAGES_PER_10MIN=  opcional, por defecto 30 por IP
