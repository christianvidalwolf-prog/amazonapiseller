# Amazon SP-API Credentials
SP_APP_ID=
LWA_CLIENT_ID=
LWA_CLIENT_SECRET=
SP_API_REFRESH_TOKEN=

# Region: EU (Europe: Spain, Germany, UK, etc.), NA (North America), or FE (Far East)
SP_API_REGION=EU

# PrestaShop Webservice (www.vidalregals.com) — Parámetros avanzados > Webservice
PS_URL=https://www.vidalregals.com
PS_API_KEY=

# Supabase: used by the daily stock sync to publish stock:latest snapshots.
# Keep the service-role key only in the local machine's .env; never commit it.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
