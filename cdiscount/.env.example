# ==============================================================================
# Configuración para API de Cdiscount
# ==============================================================================
# 
# COPIA este archivo a .env y completa con tus credenciales
#
# cp /Users/christianvidalwolf/orca/amazonapiseller/cdiscount/.env.example \
#    /Users/christianvidalwolf/orca/amazonapiseller/cdiscount/.env
#

# ============================================================================
# CREDENCIALES API CDISCOUNT
# ============================================================================

# Credenciales de autenticación (obtenidas del panel de Cdiscount)
CDISCOUNT_CLIENT_ID=tu_client_id_aqui
CDISCOUNT_CLIENT_SECRET=tu_client_secret_aqui
CDISCOUNT_API_KEY=tu_api_key_aqui

# ============================================================================
# CONFIGURACIÓN DE ENTORNO
# ============================================================================

# Usar sandbox para pruebas (true/false)
CDISCOUNT_SANDBOX=false

# ============================================================================
# CONFIGURACIÓN DE RATE LIMITING
# ============================================================================

# Requests por segundo (default: 10)
# CDISCOUNT_RATE_LIMIT_REQUESTS=10

# Máximo burst de requests (default: 20)
# CDISCOUNT_RATE_LIMIT_BURST=20

# Timeout para requests en segundos (default: 30)
# CDISCOUNT_REQUEST_TIMEOUT=30

# ============================================================================
# CONFIGURACIÓN DE REINTENTOS
# ============================================================================

# Máximo número de reintentos (default: 5)
# CDISCOUNT_MAX_RETRIES=5

# Factor de backoff exponencial (default: 2.0)
# CDISCOUNT_RETRY_BACKOFF_BASE=2.0

# Máximo delay entre reintentos en segundos (default: 60)
# CDISCOUNT_RETRY_MAX_DELAY=60

# ============================================================================
# CONFIGURACIÓN DE LOTES
# ============================================================================

# Productos por lote (default: 50)
# CDISCOUNT_BATCH_SIZE=50

# Productos por hora objetivo (default: 50)
# CDISCOUNT_PRODUCTS_PER_HOUR=50

# ============================================================================
# RUTAS DE ARCHIVOS
# ============================================================================

# Directorio de logs
# CDISCOUNT_LOG_DIR=/Users/christianvidalwolf/orca/amazonapiseller/cdiscount/logs

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
# CDISCOUNT_LOG_LEVEL=INFO

# ============================================================================
# CONFIGURACIÓN DE PRODUCTOS
# ============================================================================

# Mapeo de categorías (ejemplo)
# CDISCOUNT_CATEGORY_MAPPING='{"Electrónica": "10", "Hogar": "20"}'

# Precio mínimo (default: 5.0)
# CDISCOUNT_MIN_PRICE=5.0

# Precio máximo (default: 5000.0)
# CDISCOUNT_MAX_PRICE=5000.0

# Stock mínimo (default: 1)
# CDISCOUNT_MIN_STOCK=1

# Stock máximo (default: 9999)
# CDISCOUNT_MAX_STOCK=9999

# Stock por defecto (default: 10)
# CDISCOUNT_DEFAULT_STOCK=10

# Markup de precio por defecto (1.30 = 30%)
# CDISCOUNT_DEFAULT_PRICE_MARKUP=1.30

# ============================================================================
# NOTIFICACIONES (OPCIONAL)
# ============================================================================

# Email para alertas (opcional)
# CDISCOUNT_ALERT_EMAIL=tu@email.com

# Umbral de errores para alertar (default: 10)
# CDISCOUNT_ALERT_THRESHOLD_ERRORS=10
